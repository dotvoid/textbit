{
  "name": "@dotvoid/y-quorum",
  "version": "0.0.0",
  "license": "MIT",
  "description": "A collaboration server for people and agents writing together: typed Y.js 14 documents, permissions the server enforces, a log of who changed what.",
  "author": {
    "name": "Danne Lundqvist"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotvoid/textbit.git",
    "directory": "packages/y-quorum"
  },
  "homepage": "https://github.com/dotvoid/textbit/tree/main/packages/y-quorum#readme",
  "bugs": {
    "url": "https://github.com/dotvoid/textbit/issues"
  },
  "scripts": {
    "build": "npm run typecheck && vite build && node ../../scripts/fix-dts-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --cache --max-warnings 0",
    "test": "vitest run",
    "preversion": "vitest run && npm run build",
    "postversion": "node ../../scripts/commit-version.mjs y-quorum@ && git push && git push --tags"
  },
  "dependencies": {
    "@dotvoid/y-quorum-client": "0.0.0",
    "lib0": "^1.0.0-rc.36",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@dotvoid/textbit": "^3.0.0 || ^2.1.0",
    "@dotvoid/textbit-agent": "^1.0.0 || 0.0.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@y/protocols": "1.0.6-rc.1",
    "@y/y": "14.0.0-rc.30",
    "slate": "^0.147.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^9.29.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "@y/protocols": "1.0.6-rc.1",
    "@y/y": "14.0.0-rc.30",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@dotvoid/textbit-agent": {
      "optional": true
    }
  }
}
