{
  "name": "@dotvoid/textbit",
  "version": "2.0.0",
  "license": "MIT",
  "description": "A plugin-based rich text editor for React, built on Slate, with collaborative editing over Yjs.",
  "author": {
    "name": "Danne Lundqvist"
  },
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:types": "tsc -p tsconfig.lib.json --noEmit false",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "preview": "vite preview",
    "preversion": "vitest run && npm run build",
    "postversion": "node ../../scripts/commit-version.mjs v && git push && git push --tags",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotvoid/textbit.git",
    "directory": "packages/textbit"
  },
  "homepage": "https://github.com/dotvoid/textbit/tree/main/packages/textbit#readme",
  "bugs": {
    "url": "https://github.com/dotvoid/textbit/issues"
  },
  "peerDependencies": {
    "@slate-yjs/core": "^1.0.2",
    "@slate-yjs/react": "^1.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "slate": "^0.147.4",
    "slate-react": "^0.147.5",
    "yjs": "^13.6.26"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/is-hotkey": "^0.1.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/ui": "^4.1.12",
    "axe-core": "^4.14.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^27.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "is-hotkey": "^0.2.0",
    "slate-history": "^0.144.0",
    "y-protocols": "^1.0.5"
  }
}
