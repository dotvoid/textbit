{
  "name": "@dotvoid/textbit-plugins",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Ready to use plugins for @dotvoid/textbit: headings, formatting, lists, links, tables, code, images, audio and quotes.",
  "author": {
    "name": "Danne Lundqvist"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotvoid/textbit.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://github.com/dotvoid/textbit/tree/main/packages/plugins#readme",
  "bugs": {
    "url": "https://github.com/dotvoid/textbit/issues"
  },
  "scripts": {
    "build": "npm run typecheck && vite build && node scripts/check-treeshake.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --cache --max-warnings 0",
    "test": "vitest run",
    "preversion": "vitest run && npm run build",
    "postversion": "node ../../scripts/commit-version.mjs textbit-plugins@ && git push && git push --tags"
  },
  "peerDependencies": {
    "@dotvoid/textbit": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "slate": "^0.147.4",
    "slate-react": "^0.147.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "*",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^27.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.12"
  }
}
