{
  "name": "textbit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w textbit-demo",
    "dev:core": "npm run dev -w @dotvoid/textbit",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lab": "npm run build -w @dotvoid/textbit -w @dotvoid/textbit-plugins -w @dotvoid/textbit-agent && npm run server -w textbit-agent-lab",
    "lab:reset": "node -e \"require('fs').rmSync('apps/agent-lab/.lab', { recursive: true, force: true })\"",
    "film": "npm run build -w @dotvoid/textbit -w @dotvoid/textbit-plugins -w @dotvoid/textbit-agent && node apps/agent-lab/film/film.ts"
  }
}
